<h1>Add New Student</h1>

<% if @student.errors.any? %>
  <h2>Please fix the following errors:</h2>
  <ul>
    <% @student.errors.full_messages.each do |message| %>
      <li><%= message %></li>
    <% end %>
  </ul>
<% end %>

<%= form_with model: @student do |form| %>
  <p>
    <%= form.label :name, "Name" %><br>
    <%= form.text_field :name %>
  </p>
  <p>
    <%= form.label :email, "Email" %><br>

    <%= form.email_field :email %>
  </p>
  <p>
    <%= form.label :department, "Department" %><br>

    <%= form.text_field :department %>
  </p>
  <p>
    <%= form.label :marks, "Marks" %><br>

    <%= form.number_field :marks %>
  </p>
  <p>
    <%= form.submit "Create Student" %>
  </p>
<% end %>
<p>
  <%= link_to "Back to Students", students_path %>
</p>