<h1>Student Management System</h1>
<p>
  <%= link_to "Add New Student", new_student_path %>
</p>

<% if @students.any? %>

  <table border="1" cellpadding="10">
    <thead>
      <tr>
        <th>Name</th>
        <th>Email</th>
        <th>Department</th>
        <th>Marks</th>
        <th>Actions</th>
      </tr>
    </thead>

    <tbody>
      <% @students.each do |student| %>

        <tr>
          <td><%= student.name %></td>

          <td><%= student.email %></td>

          <td><%= student.department %></td>

          <td><%= student.marks %></td>

          <td>
            <%= link_to "Show", student_path(student) %>

            |

            <%= link_to "Edit", edit_student_path(student) %>

            |
        <%= button_to "Delete",
              student_path(student),
              method: :delete,
              data: {
                turbo_confirm: "Are you sure you want to delete this student?"
              } %>      
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No students found.</p>
<% end %>