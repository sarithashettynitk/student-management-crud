<h1>Student Details</h1>
<p>
  <strong>Name:</strong>
  <%= @student.name %>
</p>
<p>
  <strong>Email:</strong>
  <%= @student.email %>
</p>
<p>
  <strong>Department:</strong>
  <%= @student.department %>
</p>
<p>
  <strong>Marks:</strong>
  <%= @student.marks %>
</p>
<p>
  <%= link_to "Edit", edit_student_path(@student) %>
</p>
<p>
  <%= link_to "Delete",
              student_path(@student),
              data: {
                turbo_method: :delete,
                turbo_confirm: "Are you sure you want to delete this student?"
              } %>
</p>
<p>
  <%= link_to "Back to Students", students_path %>
</p>